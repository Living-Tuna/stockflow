{
  "name": "ecbills-scanner-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "ecbills.in desktop scanner bridge — USB barcode/QR capture + product portal communicating with the web app over localhost (WebSocket).",
  "author": "ecbills.in",
  "main": "main.js",
  "scripts": {
    "icon": "node generate-icon.js",
    "start": "electron .",
    "dist": "electron-builder --win --linux",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "rebuild-hook": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "in.ecbills.scannerbridge",
    "productName": "ecbills Scanner Bridge",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "ecbills-scanner-bridge-setup.${ext}"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "assets/icon.png",
      "category": "Utility",
      "artifactName": "ecbills-scanner-bridge.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "bwip-js": "^4.11.4",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  }
}